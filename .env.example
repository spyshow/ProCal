# Copy to .env and fill in. Dev defaults below point at the docker-compose
# services (postgres on 5432, Mailpit on 1025/8025).

# Postgres — docker-compose `db` service.
DATABASE_URL="postgresql://procal:procal@localhost:5432/procal?schema=public"

# Session token signing secret (jose). Generate a long random string.
JWT_SECRET="generate-a-long-random-string"

# Captured-lead notification (src/lib/notify.ts). Dev: the Mailpit container
# from docker-compose — open http://localhost:8025 to read captured leads.
# Prod: replace with your real relay (Gmail app password / SendGrid / SES)
# and set SMTP_USER/SMTP_PASS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
LEADS_TO_ADDRESS=leads@procal.local
