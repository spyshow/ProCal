# Copy to .env and fill in. Dev defaults below point at the docker-compose
# services (postgres on 5432, Mailpit on 1025/8025).

# Postgres — docker-compose `db` service.
DATABASE_URL="postgresql://procal:procal@localhost:5432/procal?schema=public"

# Session token signing secret (jose). Generate a long random string.
JWT_SECRET="generate-a-long-random-string"

# Email notifications & Project Invites (src/lib/notify.ts).
# Dev: Mailpit container from docker-compose — open http://localhost:8025 to read captured emails.
# Prod Relay (e.g. Resend / SendGrid / AWS SES / Gmail App Password):
#   For Resend:
#     SMTP_HOST=smtp.resend.com
#     SMTP_PORT=465 (or 587)
#     SMTP_USER=resend
#     SMTP_PASS=re_your_api_key_here
#     SMTP_FROM_ADDRESS="ProCal <onboarding@resend.dev>" (or your verified domain e.g. "ProCal <notifications@yourdomain.com>")
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS="ProCal <onboarding@resend.dev>"
LEADS_TO_ADDRESS=leads@procal.local

# Bootstrap admin password used ONCE by prisma/seed.ts when no ADMIN exists.
# Unset = the seed generates a random one-time password and prints it. The seed
# is NOT part of the deploy pipeline anymore - run it manually: npx tsx prisma/seed.ts
SEED_ADMIN_PASSWORD=

# --- Database TLS (remote providers only; no effect on localhost) ---
# Verification is ON by default. Supabase signs its endpoints with its own
# root CA, which Node does not trust out of the box. Preferred fix: download
# your project CA (https://supabase.com/certificates) and point to it:
#   DATABASE_SSL_CA_FILE=./certs/prod-ca.crt      (or inline PEM: DATABASE_SSL_CA=...)
# Quick/dev escape hatch (disables verification - do not use for real data):
#   DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_REJECT_UNAUTHORIZED=
