# =============================================================================
# ProCal Environment Variables Template
# =============================================================================

# Database Connections (PostgreSQL / Supabase)
# In production (Vercel):
# DATABASE_URL: Transaction pooler connection string (Port 6543, with ?pgbouncer=true)
# DIRECT_URL: Direct database connection string (Port 5432) for running migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/procal?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/procal?schema=public"

# Authentication & Security
JWT_SECRET="generate-a-secure-random-64-character-hex-secret"

# Optional bootstrap admin password for prisma/seed.ts (auto-generated if omitted)
# SEED_ADMIN_PASSWORD="change-me-in-production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Delivery (Resend - Preferred)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ProCal <no-reply@procal.app>"

# Email Delivery (SMTP Fallback - e.g. Mailpit for local dev)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
LEADS_TO_ADDRESS="leads@procal.local"

# TLS Verification (set to false if using Supabase pooler without custom CA cert)
DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Analytics (Microsoft Clarity)
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# -----------------------------------------------------------------------------
# Stripe (billing — Task 3)
# -----------------------------------------------------------------------------
# Card checkout is OPTIONAL. With no STRIPE_SECRET_KEY, /api/billing/checkout
# returns 503, /billing shows the manual credit-request form instead, and the
# MCP `procal_create_checkout` tool tells the user to buy credits by hand.
# Everything else (MCP, drawings, reports) works without any of this.
STRIPE_SECRET_KEY=""

# Required for the webhook to accept events. Without it /api/billing/webhook
# returns 503 and no purchase is ever fulfilled.
# Get it with: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=""

# Absolute origin, used for the Stripe Customer Portal return URL.
APP_URL="http://localhost:3000"

# Optional: pre-created Stripe price ids. When omitted, prices are built inline
# from the catalogue in src/lib/stripe.ts, so checkout works before anyone
# creates products in the Stripe dashboard.
# STRIPE_PRICE_STARTER_MONTHLY=""
# STRIPE_PRICE_STARTER_ANNUAL=""
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=""
# STRIPE_PRICE_TEAM_MONTHLY=""
# STRIPE_PRICE_TEAM_ANNUAL=""
# STRIPE_PRICE_SINGLE_PROJECT_PASS=""

# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------
# No configuration needed. Clients POST to /api/mcp with
# `Authorization: Bearer <token>`, where the token is minted in
# Settings -> AI Agent Access (MCP).
