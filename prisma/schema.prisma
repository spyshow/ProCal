generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String              @id @default(uuid())
  username        String              @unique
  passwordHash    String
  name            String
  email           String?             // collected at signup; pre-fills /billing + SMTP Reply-To (eng-review D3/OV-γ)
  role            String              @default("USER") // "USER" | "ADMIN" — gates /api/admin/*
  credits         Int                 @default(0)      // project credits; decremented on project create
  disabled        Boolean             @default(false)  // soft-delete; preserves project history
  createdAt       DateTime            @default(now())
  projects        Project[]
  revisions       ProjectRevision[]
  contactRequests ContactRequest[]
  projectMembers  ProjectMember[]
  sentInvites     ProjectInvite[]     @relation("SentInvites")
  reviewItems     ProjectReviewItem[]
  auditLogs       ProjectAuditLog[]
}

// Captured-lead billing loop (Approach B). One OPEN per user is enforced in-app
// (eng-review CQ-C); onDelete: Restrict guards against a manual delete that would
// orphan the lead ledger against Project.user's Cascade.
model ContactRequest {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  email            String?   // denormalized snapshot of the requester's email at submit time
  message          String
  requestedCredits Int?
  status           String    @default("OPEN") // "OPEN" | "CLOSED"
  createdAt        DateTime  @default(now())
  closedAt         DateTime?

  @@index([status]) // /admin/leads filters by status
  @@index([userId]) // dedupe lookup (CQ-C) + user relation
}

model Project {
  id                    String              @id @default(uuid())
  name                  String
  client                String
  consultant            String
  contractor            String
  location              String
  engineer              String
  date                  String
  voltage               Float               @default(400) // V (Line-to-Line)
  frequency             Float               @default(50) // Hz
  powerFactor           Float               @default(0.85)
  maxDemandFactor       Float               @default(0.8)
  transformerSize       Float? // Sized in kVA
  notes                 String?
  preferredManufacturer String              @default("MIXED") // "ABB" | "SCHNEIDER" | "MIXED"
  defaultAcbFamilyId    String?
  defaultAcbFamily      BreakerFamily?      @relation("DefaultAcbFamily", fields: [defaultAcbFamilyId], references: [id], onDelete: SetNull)
  defaultMccbFamilyId   String?
  defaultMccbFamily     BreakerFamily?      @relation("DefaultMccbFamily", fields: [defaultMccbFamilyId], references: [id], onDelete: SetNull)
  defaultMcbFamilyId    String?
  defaultMcbFamily      BreakerFamily?      @relation("DefaultMcbFamily", fields: [defaultMcbFamilyId], references: [id], onDelete: SetNull)
  country               String              @default("Syria")
  logoUrl               String?
  // Per-phase balancing: calculation standard selects the current-unbalance
  // limit + label (IEC/EN 50160 vs NEMA). Stored as a constrained string
  // (SQLite-friendly); the TS type narrows to "IEC" | "NEMA". Default IEC
  // (roadmap leans Middle-East). See design doc "Engineering Review" §D4.
  calculationStandard   String              @default("IEC") // "IEC" | "NEMA"
  maxVoltageDropLighting Float              @default(3) // % — IEC 60364-5-52 for lighting
  maxVoltageDropPower    Float              @default(5) // % — IEC 60364-5-52 for power
  ambientTemp           Float?              @default(30) // °C — default ambient temperature
  groupingCount         Int?                @default(1)  // default number of grouped circuits
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildings             Building[]
  apartmentTemplates    ApartmentTemplate[]
  loadLibraryItems      LoadLibraryItem[]
  revisions             ProjectRevision[]
  members               ProjectMember[]
  invites               ProjectInvite[]
  auditLogs             ProjectAuditLog[]
  reviewItems           ProjectReviewItem[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// Join table connecting Users to Projects with granular roles & page permissions
model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("ENGINEER") // "PROJECT_MANAGER" | "ENGINEER" | "QA"
  permissions String?  // JSON-serialized map of page permissions, e.g. {"calculator":"EDIT","cableSchedule":"VIEW"}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

// Pending invitations sent via email
model ProjectInvite {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  name        String
  role        String   @default("ENGINEER") // "PROJECT_MANAGER" | "ENGINEER" | "QA"
  permissions String?  // JSON-serialized initial permissions assigned by PM
  token       String   @unique
  invitedById String
  invitedBy   User     @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  status      String   @default("PENDING") // "PENDING" | "ACCEPTED" | "REVOKED" | "EXPIRED"
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([token])
  @@index([email])
}

// Activity & Audit Log: track who changed what in the project
model ProjectAuditLog {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String   // Snapshot of user name (retained even if user is removed)
  userRole    String   // Role snapshot at the time of change
  action      String   // "CREATE" | "UPDATE" | "DELETE" | "INVITE" | "REVISION" | "MEMBER_REMOVE" | "MEMBER_ROLE"
  entityType  String   // "PROJECT" | "CABLE" | "BREAKER" | "BUILDING_LOAD" | "PANEL" | "TEAM" | "SLD" | "QA_NOTE"
  entityId    String?
  description String   // e.g. "Changed Main Incomer breaker rating to 1600A ACB"
  details     String?  // JSON-serialized optional before/after diff snapshot
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, entityType])
  @@index([projectId, userId])
}

// QA Discrepancy / Compliance Punch List
model ProjectReviewItem {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  pageKey     String    // "cableSchedule" | "breakerSchedule" | "calculator" | "sld" | "general"
  severity    String    @default("WARNING") // "CRITICAL" | "WARNING" | "NOTE"
  title       String    // e.g. "Voltage drop exceeds 5% on Feeder L3-Power"
  description String
  status      String    @default("OPEN")    // "OPEN" | "RESOLVED" | "WONT_FIX"
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([projectId, status])
}

/**
 * Issued revision of a project's engineering state. Each record snapshots the
 * full serialized project (buildings / floors / items / templates) so an issued
 * revision stays reproducible even after the live project changes.
 */
model ProjectRevision {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rev          String // "R0", "R1", …
  description  String
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  snapshotJson String // JSON.stringify(project) at issue time
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Building {
  id                  String        @id @default(uuid())
  name                String
  floors              Int
  serviceFloors       Int
  apartmentsPerFloor  Int
  mechanicalLoads     String? // JSON string of mechanical loads: [{name, power, pf, qty, isEssential}]
  generator           Float? // Sized generator kVA
  transformer         Float? // Sized transformer kVA
  supplyVoltage       String        @default("400V 3-Phase")
  earthingSystem      String        @default("TN-S")
  lightningProtection Boolean       @default(false)
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorDesigns        FloorDesign[]
  buildingLoads       BuildingLoad[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model BuildingLoad {
  id                String           @id @default(uuid())
  buildingId        String
  building          Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  loadLibraryItemId String?
  loadLibraryItem   LoadLibraryItem? @relation(fields: [loadLibraryItemId], references: [id], onDelete: SetNull)
  quantity          Int              @default(1)
  cableSize         String?
  cableLength       Float?
  installMethod     String?
  cableInsulation   String?
  cableMaterial     String?          @default("copper") // "copper" or "aluminum"
  ambientTemp       Float?           @default(30)
  groupingCount     Int?             @default(1)
  // Per-phase balancing: which phase (1=L1, 2=L2, 3=L3) a single-phase building
  // load is assigned to. null = unassigned → phaseBalance computes the greedy
  // LPT assignment on-read (stable order). Only meaningful for 1-phase loads;
  // 3-phase loads draw from all three and ignore this. See design doc §premise 2.
  assignedPhase     Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ApartmentTemplate {
  id          String          @id @default(uuid())
  name        String
  phases      Int             @default(1) // 1 or 3
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rooms       ApartmentRoom[]
  floorItems  FloorItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ApartmentRoom {
  id            String            @id @default(uuid())
  type          String // KITCHEN, BEDROOM, LIVING_ROOM, DINING_ROOM, BATHROOM, HALL, OTHER
  name          String // Display name e.g., "Master Bedroom"
  area          Float // m²
  hasAc         Boolean           @default(false)
  acBtu         Int? // Auto-calculated from area if hasAc
  loadDensity   Float // VA/m² - loaded from country defaults, overridable
  connectedLoad Float // Calculated: area × loadDensity + AC watts
  templateId    String
  template      ApartmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model LoadLibraryItem {
  id              String      @id @default(uuid())
  name            String
  category        String // "Lighting", "Socket", "AC", "Pump", "Elevator", etc.
  power           Float // in kW
  voltage         Float       @default(230) // V
  phase           Int         @default(1) // 1 or 3
  powerFactor     Float       @default(0.85)
  demandFactor    Float       @default(1.0)
  quantity        Int         @default(1)
  runningCurrent  Float       @default(0) // calculated/stored
  startingCurrent Float?
  notes           String?
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorItems      FloorItem[]
  buildingLoads   BuildingLoad[]
}

model FloorDesign {
  id                  String      @id @default(uuid())
  floorNumber         Int
  hasFloorSubPanels   Boolean     @default(false)
  riserCableLength    Float?      // meters — riser cable from MDB to SDB (only for hasFloorSubPanels=true)
  riserCableSize      String?     // e.g., "120 mm²" — riser cable size (only for hasFloorSubPanels=true)
  riserBreakerSize    String?     // e.g., "630A" — user-overridden riser breaker frame
  riserInstallMethod   String?    @default("C")   // IEC 60364-5-52: B1, B2, C, E, F, G (riser cable, SDB only)
  riserCableInsulation String?    @default("XLPE") // "PVC" or "XLPE" (riser cable, SDB only)
  riserCableMaterial   String?    @default("copper") // "copper" or "aluminum" (riser cable, SDB only)
  riserAmbientTemp    Float?      @default(30)    // °C (riser cable, SDB only)
  riserGroupingCount  Int?        @default(1)     // grouping (riser cable, SDB only)
  buildingId          String
  building            Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  items               FloorItem[]
}

model FloorItem {
  id                      String             @id @default(uuid())
  type                    String // "APARTMENT" | "SERVICE_PANEL" | "PUMP_PANEL" | "ELEVATOR_PANEL"
  name                    String // display name e.g., "Apartment 1" or "Service Board"
  apartmentTemplateId     String?
  apartmentTemplate       ApartmentTemplate? @relation(fields: [apartmentTemplateId], references: [id], onDelete: SetNull)
  loadLibraryItemId       String?
  loadLibraryItem         LoadLibraryItem?   @relation(fields: [loadLibraryItemId], references: [id], onDelete: SetNull)
  floorDesignId           String
  floorDesign             FloorDesign        @relation(fields: [floorDesignId], references: [id], onDelete: Cascade)
  calculatedConnectedLoad Float              @default(0)
  calculatedMaxDemand     Float              @default(0)
  calculatedCurrent       Float              @default(0)
  breakerSize             String?
  cableSize               String?
  cableLength             Float?  // meters — configurable per circuit
  voltageDrop             Float?
  installMethod           String? @default("C") // IEC 60364-5-52: B1, B2, C, E, F, G
  cableInsulation         String? @default("XLPE") // "PVC" or "XLPE"
  cableMaterial           String? @default("copper") // "copper" or "aluminum"
  ambientTemp             Float?  @default(30) // °C
  groupingCount           Int?    @default(1)
  // Per-phase balancing: which phase (1=L1, 2=L2, 3=L3) a single-phase floor
  // item is assigned to. null = unassigned → phaseBalance computes the greedy
  // LPT assignment on-read (stable order floorNumber→createdAt→id). Only
  // meaningful for 1-phase loads; 3-phase loads draw from all three and ignore
  // this. See design doc §premise 2.
  assignedPhase           Int?
}

model EquipmentCatalog {
  id               String  @id @default(uuid())
  category         String // "ACB" | "MCCB" | "MCB" | "RCCB" | "RCBO" | "SPD" | "CONTACTOR" | "OVERLOAD" | "METER" | "CT"
  manufacturer     String // "ABB" | "SCHNEIDER"
  series           String // e.g. "Emax 2", "Tmax XT4", "Acti9 iC60"
  model            String // e.g. "E2.2B 1600"
  ratedCurrent     Float // nominal current rating (In) in A
  poles            Int     @default(3)
  breakingCapacity Float // Icu in kA
  tripUnit         String? // e.g. "Ekip Dip LSI", "MicroLogic 2.2"
  settingsJson     String? // JSON string: adjustable protection settings ranges
  datasheetUrl     String?
  familyId         String?
  family           BreakerFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@unique([manufacturer, category, series, model, ratedCurrent, poles], name: "catalogUniqueKey")
  @@index([familyId])
}

model BreakerFamily {
  id           String            @id @default(uuid())
  manufacturer String // e.g. "ABB" | "Schneider"
  category     String // "ACB" | "MCCB" | "MCB"
  name         String // e.g. "ComPacT NSX", "Acti9 iC60"
  catalogItems EquipmentCatalog[]
  defaultAcb   Project[]         @relation("DefaultAcbFamily")
  defaultMccb  Project[]         @relation("DefaultMccbFamily")
  defaultMcb   Project[]         @relation("DefaultMcbFamily")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([manufacturer, category, name])
}

model BreakerSettings {
  id           String   @id @default(uuid())
  breakerId    String   @unique // The unique tag of the feeder in the design (e.g. "proj1-mdb-main")
  model        String
  manufacturer String
  frameSize    String
  ir           Float // L pickup setting
  tr           Float // L delay setting
  isd          Float? // S pickup setting
  tsd          Float? // S delay setting
  i2t          Boolean? // S I2t state (on/off)
  ii           Float? // I pickup setting
  ig           Float? // G pickup setting
  tg           Float? // G delay setting
}
